# BuyUadvice — this folder IS the web root. Upload its CONTENTS to public_html/.
# Serves React SPA (index.html) + PHP API (/backend/* -> index.php).

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # API: /backend/auth/... -> /index.php (keeps frontend fetch URLs working).
  # The physical backend/ subfolder does NOT exist — this rewrite is what makes it work.
  RewriteCond %{REQUEST_URI} ^/backend/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^backend/(.*)$ index.php [QSA,L]

  # Block direct access to PHP source / secrets (API goes via /backend/* only).
  RewriteRule ^(auth|config|vendor|sql)(/|$) - [F,L]
  RewriteRule ^(router\.php|composer\.(json|lock))$ - [F,L]
  RewriteRule (^\.|/\.env$) - [F,L]

  # SPA fallback — React Router.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header set Access-Control-Allow-Credentials "true"
</IfModule>

# Extra guard if mod_rewrite is off.
<FilesMatch "^(\.env|router\.php|composer\.(json|lock))$">
  Require all denied
</FilesMatch>
